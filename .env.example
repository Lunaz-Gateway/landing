# Sunday Market demo app linked from "Try Sunday Market"
VITE_DEMO_URL=http://localhost:3000
# Documentation site linked from the nav, the developers section and the footer
VITE_DOCS_URL=http://localhost:4321

# Magic publishable key (pk_...), public, baked into the client at build time
VITE_MAGIC_PUBLISHABLE_KEY=
# Magic secret key (sk_...), server only, never prefix with VITE_
MAGIC_SECRET_KEY=
# Shared secret that authorizes this server to call core-service /v1/auth/exchange (server only)
LUNAZ_INTERNAL_TOKEN=
